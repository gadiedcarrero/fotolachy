# Base de datos Postgres (Neon, Vercel Postgres, Supabase, local...)
# Ejemplo local:  postgresql://postgres:postgres@localhost:5432/fotolachy
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Contraseña del panel /admin
ADMIN_PASSWORD="admin123"

# Cadena larga y aleatoria para firmar la cookie de sesión (cámbiala)
AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# Fotos subidas.
# - En Vercel: crea un Blob store y Vercel define BLOB_READ_WRITE_TOKEN automáticamente.
# - En local (sin token): se guardan en UPLOAD_DIR y se sirven por /media/.
# BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR="./data/uploads"
